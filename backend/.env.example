# SAARTHI SafePay backend configuration
# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Google Gemini API key (https://aistudio.google.com)
# Used for intelligent fallback Q&A, message thinking analysis, and multimodal processing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI API key (https://dashboard.sarvam.ai).
# Leave empty to run the app fully: voice endpoints will report
# status="unavailable" and the UI falls back to typed text / browser voice.
SARVAM_API_KEY=

# Sarvam endpoints + models (defaults shown; override only if needed)
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
# Optional: force a bulbul:v3 speaker (e.g. shubh, ritu). Empty = API default.
SARVAM_TTS_SPEAKER=

# Comma-separated CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Voice request timeout in seconds
VOICE_TIMEOUT_SECONDS=25

# Maximum accepted audio upload size (MB) for speech-to-text
MAX_AUDIO_MB=10

# Speech to text and TTS engines
USE_EDGE_TTS=true
USE_GOOGLE_STT=true
